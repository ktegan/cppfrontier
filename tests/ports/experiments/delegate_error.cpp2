// Experiment delegate (docs/EXPERIMENTS.md): a selected function that
// @delegate cannot forward, as a function without `this` or a private one,
// is rejected rather than ignored.
// flags: -experiment=delegate
// expect-error: 'Src::make' is not a public function taking an 'in' or 'inout' 'this', so @delegate cannot forward it
// expect-error: 'Src::secret' is not a public function taking an 'in' or 'inout' 'this', so @delegate cannot forward it

Src: type = {
    operator=: (out this) = { }
    make: () -> i32 = 0;
    hidden: (this) -> i32 = 1;
    private secret: (this) -> i32 = 2;
}

Dst: @delegate<s, make, secret> type = {
    s: Src = ();
    operator=: (out this) = { }
}

main: () -> int = 0;
