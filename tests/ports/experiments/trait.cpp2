// Experiment trait (docs/EXPERIMENTS.md): a @trait is a concept checked at
// each @impl type and at the definition of a constrained function template,
// and dyn_Shape holds any type that satisfies it.
// flags: -experiment=trait
#include <iostream>
#include <string>
#include <vector>

Shape: @trait type = {
    area: (this) -> double;
    name: (this) -> std::string;
}

Circle: @impl<Shape> @value type = {
    r: double = 0;
    operator=: (out this, r_: double) = { r = r_; }
    area: (this) -> double = 3.0 * r * r;
    name: (this) -> std::string = "circle";
}

Square: @value type = {
    s: double = 0;
    operator=: (out this, s_: double) = { s = s_; }
    area: (this) -> double = s * s;
    name: (this) -> std::string = "square";
}
Square_is_Shape: @impl<Shape, Square> type = { }

describe: <T: Shape> (x: T) -> std::string = x.name() + " " + std::to_string(x.area());

main: () = {
    shapes: std::vector<dyn_Shape> = (Circle(1.0), Square(2.0));
    for shapes do (s) { std::cout << describe(s) << "\n"; }
}
