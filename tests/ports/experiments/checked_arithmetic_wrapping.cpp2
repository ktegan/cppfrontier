// Experiment checked-arithmetic (docs/EXPERIMENTS.md): unsigned arithmetic is
// checked too, and `wrapping_add`, `wrapping_sub` and `wrapping_mul` compute
// arithmetic that is meant to wrap, here an FNV-1a hash.
// flags: -experiment=checked-arithmetic

fnv1a: (s: std::string_view) -> u64 = {
    h: u64 = 14695981039346656037;
    for s do (c) {
        h = (h ^ (c as u8 as u64)).wrapping_mul(1099511628211);
    }
    return h;
}

main: () = {
    std::cout << fnv1a("hello") << "\n";
    m: i32 = 2147483647;
    std::cout << wrapping_add(m, 1) << " " << m.wrapping_sub(-1) << "\n";
    n: u8 = 200;
    std::cout << wrapping_mul(n, n) << "\n";
}
