// A loop or `if` is a statement, not an expression, so it cannot initialize
// or be assigned.
// expect-error: 'while' begins a statement, not an expression
// expect-error: 'if' begins a statement, not an expression
// expect-error: 'for' begins a statement, not an expression
f: () = {
    i := 0;
    x := while i < 3 next i++ { }
}
g: (inout i: int) = {
    i = if i > 0 { 1 } else { 2 }
}
h: () = {
    x := for (1, 2) do (e) { }
}
main: () = { }
