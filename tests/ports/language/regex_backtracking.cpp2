// Source: metafunctions.md @regex and notes/regex_status.md (Perl syntax and
// semantics, perlre): quantifiers backtrack into their repetitions, a
// repetition that matches nothing ends the loop, a backreference to a group
// that has not matched fails, and a group keeps the value of its last
// successful repetition. Each line was checked against perl 5.40. Upstream
// cppfront hangs on `(a?)+?b`, rejects `[:digit:]` and `[:^alpha:]`, and
// differs on most other lines.
#include <iostream>

show: (name: std::string, r) = {
    std::cout << name << ":";
    if !r.matched {
        std::cout << " no\n";
        return;
    }
    i := 0;
    while i < cpp2::unchecked_narrow<int>(r.group_number()) next i++ {
        if r.ctx.get_group(i).matched {
            std::cout << " " << r.group_start(i) << "-" << r.group_end(i);
        }
        else {
            std::cout << " unset";
        }
    }
    std::cout << "\n";
}

m: @regex type = {
    regex_lazy_alt := R"((?:a|ab)+?c)";            // backtracks into an earlier repetition
    regex_lazy_group := R"((a|ab)*?c)";
    regex_lazy_empty := R"((a?)+?b)";              // the empty repetition ends the loop
    regex_lazy_count := R"((?:a|ab){1,2}?c)";
    regex_possessive_min := R"((?:a|ab){2}+c)";    // the first greedy match, then no backtracking
    regex_greedy_alt := R"((a|ab)*c)";             // the last repetition is the one that matched
    regex_stale := R"((.{1,}){1,}?a{1,3}?)";
    regex_unset_ref := R"((a)?\1b)";               // a reference to an unset group fails
    regex_own_ref := R"((a|b\1)+)";                // inside a group, its previous repetition
    regex_empty_end := R"((a?)?)";                 // one empty repetition at the end
    regex_empty_ref := R"((a?)??\1)";
    regex_restore := R"(^(?:b|a(?=(.)))*\1)";
    regex_branch_reset := R"((?|x|(?:(b)|c)(d)))"; // only top-level alternatives restart
    regex_posix := R"([[:digit:]]+[[:^alpha:]]+)";
}

main: () = {
    v: m = ();
    show("lazy alt", v.regex_lazy_alt.search("abc"));
    show("lazy group", v.regex_lazy_group.search("abc"));
    show("lazy empty", v.regex_lazy_empty.search("c"));
    show("lazy empty b", v.regex_lazy_empty.search("aab"));
    show("lazy count", v.regex_lazy_count.search("abc"));
    show("possessive min", v.regex_possessive_min.search("abac"));
    show("possessive min none", v.regex_possessive_min.search("aabc"));
    show("greedy alt", v.regex_greedy_alt.search("abc"));
    show("stale", v.regex_stale.search("_ -1-_a"));
    show("unset ref", v.regex_unset_ref.search("b"));
    show("unset ref set", v.regex_unset_ref.search("aab"));
    show("own ref", v.regex_own_ref.search("aba"));
    show("empty end", v.regex_empty_end.search(""));
    show("empty ref", v.regex_empty_ref.search(""));
    show("restore", v.regex_restore.search("abc"));
    show("branch reset b", v.regex_branch_reset.search("bd"));
    show("branch reset c", v.regex_branch_reset.search("cd"));
    show("posix", v.regex_posix.search("ab12-!c"));
}
