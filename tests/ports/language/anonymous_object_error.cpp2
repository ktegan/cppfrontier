// expect-error: (28,18): error: an object can have an anonymous name or an anonymous type
f: () -> int = 1;

_ := f();
t: type = {
    _ := 1;
    _: _ = 2;
}
main: () = {
    _ := f();
    _: _ = f();
    _: const _ = f();
    static _ := f();
    (_ := 1) while false { }
    l := :() = { _ := 3; };
}
