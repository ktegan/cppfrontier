// expect-error: 'std::string&&' is a Cpp1 reference type
// expect-error: a function type cannot have named return values
f: (copy x: const int&) -> int = x;
g: (x: std::string&&) = { }
h: (fp: *(x: int) -> (r: int)) = { }

main: () = {
    a := 1;
    r: int& = a;
    r = 7;
}
