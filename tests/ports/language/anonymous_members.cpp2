// Source: objects.md, a data member named `_`. Each gets a name unique by
// its position, which the members generated by @value, @copyable, @hashable
// and @struct, and the memberwise defaults of written constructors and
// assignments, copy, move and hash. Upstream emits these members as `_`
// in the generated code, which does not compile.
counted: type = {
    public n: int = 0;
    operator=: (out this) = { }
    operator=: (out this, that) = { n = that.n + 1; std::cout << "copy " << n << "\n"; }
    operator<=>: (this, that) -> std::strong_ordering = std::strong_ordering::equal;
    operator==: (this, that) -> bool = true;
}

point: @value type = {
    public _: counted = ();
    public x: int = 2;
    public _: std::string = "pad";
}

keyed: @hashable @struct type = {
    _: int = 1;
    key: int = 2;
}

holder: type = {
    _: counted = ();
    v: int = 0;
    operator=: (out this) = { }
    operator=: (out this, that) = { }
    operator=: (out this, value: int) = { v = value; }
    get: (this) -> int = v;
}

base: type = { public k: int = 7; }
derived: @struct type = {
    this: base = ();
    _: int = 1;
    x: int = 2;
}

main: () = {
    a: point = ();
    b := a;
    std::cout << (a == b) << " " << b.x << "\n";
    c: keyed = ();
    d: keyed = ();
    std::cout << (c.hash() == d.hash()) << "\n";
    e: holder = ();
    f := e;
    g: holder = 5;
    f = g;
    std::cout << f.get() << "\n";
    h: derived = (5, 6);
    std::cout << h.k << h.x << "\n";
}
