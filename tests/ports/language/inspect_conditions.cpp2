// Source: expressions.md "inspect": an inspect expression is an expression,
// so it may be an `if`, `else if`, `while` or `do` condition, where its braces
// are not the body, and a `next` clause may follow it.
main: () = {
    x := 2;
    if inspect x -> bool { is 2 = true; is _ = false; } { std::cout << "if "; }
    if x == 1 { }
    else if inspect x -> bool { is (:(n) -> bool = n > 1;) = true; is _ = false; } {
        std::cout << "else-if ";
    }
    i := 0;
    while inspect i -> bool { is 3 = false; is _ = true; } next i++ { std::cout << i; }
    do { x--; } while inspect x -> bool { is 0 = false; is _ = true; };
    std::cout << " " << x << "\n";
}
