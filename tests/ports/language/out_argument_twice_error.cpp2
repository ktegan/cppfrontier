// Source: functions.md "Parameters": an `out` argument initializes or assigns
// its object. Passing one object as `out` twice in one expression initializes
// or assigns it twice, in an unspecified order (upstream fails at run time
// for a deferred local). Alternatives of one `inspect` are exclusive, so each
// may pass it once. The rule holds in every expression: a statement, a
// returned value, an expression body and a contract.
// expect-error: x is passed as 'out' more than once in one expression
// expect-error: y is passed as 'out' more than once in one expression
// expect-error: r is passed as 'out' more than once in one expression
// expect-error: e is passed as 'out' more than once in one expression
// expect-error: c is passed as 'out' more than once in one expression
set2: (out a: int, out b: int) = { a = 1; b = 2; }
set1: (out a: int) -> int = { a = 1; return 0; }

returned: () -> int = { r: int; return set1(out r) + set1(out r); }
body: (out e: int) -> int = set1(out e) + set1(out e);
checked: (inout c: int) = { assert(set1(out c) + set1(out c) == 0); }

main: () = {
    x: int;
    set2(out x, out x);
    y: int = 0;
    set2(out y, out y);
    z: int = 0;
    _ = inspect 1 -> int { is 1 = set1(out z); is _ = set1(out z); };
    std::cout << x << y << z << "\n";
}
