// Source: Cpp1 output statements with a missing '<<' or '+', and a Cpp1
// attribute-like '@' inside an expression. Juxtaposed operands are not an
// expression; adjacent string literals are one literal.
// expect-error: unexpected text 'name' after an expression
// expect-error: unexpected text '2' after an expression
// expect-error: unexpected text 'std::endl' after an expression
// expect-error: unexpected text 'y' after an expression
// expect-error: unexpected text '@'
main: () = {
    name := "x";
    greeting := "hello, " "world";
    s := "a" name "b";
    n := 1 2;
    std::cout << greeting std::endl;
    x := 1;
    y := 2;
    if x y { }
    z := 1 @ 2;
}
