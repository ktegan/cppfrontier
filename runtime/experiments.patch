+//  A comparison with a non-negative decimal literal, which converts to either
+//  signedness without changing its value, rejects only bool operands; so the
+//  mixed-sign comparison warning does not apply
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#define CPP2_CMP_LITERAL(name, op) \
+CPP2_FORCE_INLINE constexpr auto name(auto&& t, auto&& u) \
+    -> decltype(auto) \
+{ \
+    static_assert( \
+        !std::is_same_v<CPP2_TYPEOF(t), bool> && !std::is_same_v<CPP2_TYPEOF(u), bool>, \
+        "comparing bool values using < <= >= > is unsafe and not allowed - are you missing parentheses?" \
+        ); \
+    return CPP2_FORWARD(t) op CPP2_FORWARD(u); \
+}
+CPP2_CMP_LITERAL(cmp_less_literal, <)
+CPP2_CMP_LITERAL(cmp_less_eq_literal, <=)
+CPP2_CMP_LITERAL(cmp_greater_literal, >)
+CPP2_CMP_LITERAL(cmp_greater_eq_literal, >=)
+#undef CPP2_CMP_LITERAL
+#pragma GCC diagnostic pop
