+//  An `@adt` type (cppfrontier experiment `adt`): `is` and `as` look through
+//  it to the `std::variant` of its cases that `cpp2_adt_value()` returns
+template< typename X >
+concept adt = requires (X const& x) {
+    { x.cpp2_adt_value() } -> specialization_of_template<std::variant>;
+};
+
+template< typename C, adt X >
+constexpr auto is( X const& x ) -> bool {
+    if constexpr (std::is_same_v<C, X> || std::is_base_of_v<C, X>) {
+        return true;
+    }
+    else {
+        return bool{is<C>(x.cpp2_adt_value())};
+    }
+}
+
+template< typename C, typename V >
+constexpr bool is_variant_alternative = false;
+
+template< typename C, typename... Ts >
+constexpr bool is_variant_alternative<C, std::variant<Ts...>> = (std::is_same_v<C, Ts> || ...);
+
+//  `as` a case only, so other conversions of the type are the general `as`
+template< typename C, typename X >
+    requires (adt<std::remove_cvref_t<X>> && is_variant_alternative<C,
+        std::remove_cvref_t<decltype(std::declval<X const&>().cpp2_adt_value())>>)
+auto as( X&& x CPP2_SOURCE_LOCATION_PARAM_WITH_DEFAULT_AS ) -> decltype(auto) {
+    return as<C>(CPP2_FORWARD(x).cpp2_adt_value() CPP2_SOURCE_LOCATION_ARG_AS);
+}
